        "200": "#059669",
        "300": "#2faa7e",
        "400": "#52bb94",
        "500": "#78cdac",
        "600": "#9eddc4",
        "700": "#c0ecda",
        "800": "#dcf5ea",
        "900": "#edfbf4"
      },
      "cyan": {
        "100": "#0d8c7e",
