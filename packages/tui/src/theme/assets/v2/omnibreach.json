        "400": "#64c7bb",
        "500": "#88d6cd",
        "600": "#a9e4dd",
        "700": "#c6efea",
        "800": "#e0f6f3",
        "900": "#f0fbf9"
      },
      "blue": {
        "100": "#226bcc",
        "200": "#3b7dd8",
        "300": "#518ee4",
        "400": "#67a0f0",
        "500": "#7db1fc",
        "600": "#9cc3fa",
        "700": "#b7d4fd",
        "800": "#d4e5fd",
        "900": "#f0f6fe"
      },
      "purple": {
        "100": "#6b47a7",
        "200": "#7b5bb6",
        "300": "#8c6fc5",
        "400": "#9d83d4",
        "500": "#af98e3",
        "600": "#c1acf2",
        "700": "#d3c3fc",
        "800": "#e4dbfd",
        "900": "#f6f3ff"
      },
      "accent": "$hue.red",
      "interactive": "$hue.cyan",
      "neutral": "$hue.gray"
    },
    "categorical": [
      "red",
      "orange",
      "purple",
      "blue",
      "green"
    ],
    "text": {
      "action": {
        "primary": {
          "$focused": "$hue.neutral.900"
        },
        "destructive": {
          "base": "$hue.neutral.900"
        }
      },
      "feedback": {
        "warning": {
          "base": "#b45309"
        }
      }
    },
    "border": {
      "base": "#cbd5e1"
    },
    "scrollbar": {
      "base": "#94a3b8"
    },
    "diff": {
      "text": {
        "added": "#1e725c",
        "context": "#475069",
        "hunkHeader": "#475069"
      },
      "background": {
        "added": "#d5efe5",
        "removed": "#fbdce0"
      },
      "highlight": {
        "added": "#34d399",
        "removed": "#e06c75"
      },
      "lineNumber": {
        "text": "#64748b",
        "background": {
          "added": "#c5e5da",
          "removed": "#f2ccd2"
        }
      }
    },
    "syntax": {
      "number": "#b45309",
      "type": "$hue.purple.200"
    },
    "markdown": {
      "strong": "#b45309"
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#ffffff",
        "200": "#f1f5f9",
        "300": "#cbd5e1",
        "400": "#94a3b8",
        "500": "#364156",
        "600": "#2d3548",
        "700": "#232938",
        "800": "#1a1d2e",
        "900": "#141726"
      },
      "red": {
