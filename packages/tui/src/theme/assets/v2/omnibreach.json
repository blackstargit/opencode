        "300": "#c35a63",
        "400": "#a74952",
        "500": "#8c3941",
        "600": "#722931",
        "700": "#591921",
        "800": "#410a13",
        "900": "#280207"
      },
      "orange": {
        "100": "#fddac5",
        "200": "#fab283",
        "300": "#d8976c",
        "400": "#b67c56",
        "500": "#966341",
        "600": "#774a2c",
        "700": "#593319",
        "800": "#3d1d06",
        "900": "#1f0b01"
      },
      "green": {
        "100": "#6ee7b7",
